<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SpawnGroups>

    <SpawnGroup>
      <Id>
        <TypeId>SpawnGroupDefinition</TypeId>
        <SubtypeId>GFA_ANS_Persistent_JundarFarmstead_Outlook_SpawnGroup</SubtypeId>
      </Id>
      <Description>
        [Modular Encounters SpawnGroup]

        [FalseSandboxVariables:{SpawnGroupName}_Destroyed]

        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]

        [ManipulationProfiles:GFA_ANS_Manipulation]

        [FactionOwner:CIV]

		    [IgnoreCleanupRules:true]
        [GridsAreDestructable:false]

			  [TriggerRadius:10000]

        [StaticEncounter:true]
        [ForceStaticGrid:true]
        [ForceExactPositionAndOrientation:true]

        [StaticEncounterCoords:{X:2981189.52648293 Y:-995850.23332309 Z:-3819015.89319587}]
        [StaticEncounterForward:{X:-0.878752222505061 Y:-0.0367583032619185 Z:0.475860650383828}]
        [StaticEncounterUp:{X:-0.476455495277538 Y:0.00904419342104863 Z:-0.879152070796172}]

        [StaticEncounterUsePlanetDirectionAndAltitude:true]
        [StaticEncounterPlanet:Ansion]
        [StaticEncounterPlanetDirection:{X:-0.476398287717284 Y:0.00905302042528101 Z:-0.879182981114409}]
        [StaticEncounterPlanetAltitude:-0.0180526737167384]
      </Description>
      <Icon>Textures\GUI\Icons\Fake.dds</Icon>
      <Frequency>1.0</Frequency>
      <Prefabs>
        <Prefab SubtypeId="[MES-ANS]Jundar Farmstead Outlook">
          <Position>
            <X>0.0</X>
            <Y>0.0</Y>
            <Z>0.0</Z>
          </Position>
          <Speed>0</Speed>
          <Behaviour>GFA_ANS_Persistent_JundarFarmstead_Outlook_Behavior</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>

  </SpawnGroups>
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_Persistent_JundarFarmstead_Outlook_SpawnConditions</SubtypeId>
      </Id>
      <Description>
        [MES Spawn Conditions]

        [FalseSandboxVariables:{SpawnGroupName}_Destroyed]

        [RivalAiAnySpawn:true]
        [FactionOwner:CIV]

		    [IgnoreCleanupRules:true]
        [GridsAreDestructable:false]

			  [TriggerRadius:10000]

        [StaticEncounter:true]
        [ForceStaticGrid:true]
        [ForceExactPositionAndOrientation:true]

        [StaticEncounterCoords:{X:2981189.52648293 Y:-995850.23332309 Z:-3819015.89319587}]
        [StaticEncounterForward:{X:-0.878752222505061 Y:-0.0367583032619185 Z:0.475860650383828}]
        [StaticEncounterUp:{X:-0.476455495277538 Y:0.00904419342104863 Z:-0.879152070796172}]

        [StaticEncounterUsePlanetDirectionAndAltitude:true]
        [StaticEncounterPlanet:Ansion]
        [StaticEncounterPlanetDirection:{X:-0.476398287717284 Y:0.00905302042528101 Z:-0.879182981114409}]
        [StaticEncounterPlanetAltitude:-0.0180526737167384]
      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_Persistent_JundarFarmstead_Outlook_Behavior</SubtypeId>
      </Id>
      <Description>
        [RivalAI Behavior]

	      [BehaviorName:Passive]

        [TriggerGroups:GFA_ANS_PersistentCommon_TriggerGroup]

