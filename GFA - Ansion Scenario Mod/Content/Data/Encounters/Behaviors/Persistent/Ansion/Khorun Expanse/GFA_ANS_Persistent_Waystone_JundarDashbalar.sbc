        <TypeId>SpawnGroupDefinition</TypeId>
        <SubtypeId>GFA_ANS_Persistent_Waystone_JundarDashbalar_SpawnGroup</SubtypeId>
      </Id>
      <Description>
        [Modular Encounters SpawnGroup]

        [FalseSandboxVariables:{SpawnGroupName}_Destroyed]

        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]

        [ManipulationProfiles:GFA_ANS_Manipulation_Persistent]

        [FactionOwner:CIV]

		    [IgnoreCleanupRules:true]
        [GridsAreDestructable:false]
        [ReplenishSystems:true]

			  [TriggerRadius:10000]

        [StaticEncounter:true]
        [ForceStaticGrid:true]
        [ForceExactPositionAndOrientation:true]

        [StaticEncounterCoords:{X:2987524.22181614 Y:-991383.746929189 Z:-3820875.3453755}]
        [StaticEncounterForward:{X:-0.927899629598605 Y:-0.0894986512029291 Z:0.361928541045921}]
        [StaticEncounterUp:{X:-0.369391005056996 Y:0.0891401334344386 Z:-0.924988822632076}]

        [StaticEncounterUsePlanetDirectionAndAltitude:true]
        [StaticEncounterPlanet:Ansion]
        [StaticEncounterPlanetDirection:{X:-0.369479454495208 Y:0.0893042307387643 Z:-0.924937666590609}]
        [StaticEncounterPlanetAltitude:-0.946648392899078]
      </Description>
      <Icon>Textures\GUI\Icons\Fake.dds</Icon>
      <Frequency>1.0</Frequency>
      <Prefabs>
        <Prefab SubtypeId="[MES-ANS]Waystone[Jundar-Dashbalar]">
          <Position>
            <X>0.0</X>
            <Y>0.0</Y>
            <Z>0.0</Z>
          </Position>
          <Speed>0</Speed>
          <Behaviour>GFA_ANS_Persistent_Waystone_JundarDashbalar_Behavior</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>

