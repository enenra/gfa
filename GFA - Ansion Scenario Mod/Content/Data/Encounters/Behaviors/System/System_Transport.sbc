    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_TriggerGroup</SubtypeId>
      </Id>
      <Description>
        [RivalAI TriggerGroup]

        [Triggers:GFA_ANS_System_Transport_Trigger_TargetIndex_0]
        [Triggers:GFA_ANS_System_Transport_Trigger_TargetIndex_1]
        [Triggers:GFA_ANS_System_Transport_Trigger_TargetIndex_2]
        [Triggers:GFA_ANS_System_Transport_Trigger_TargetIndex_3]
      </Description>
    </EntityComponent>


    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_Trigger_TargetIndex_0</SubtypeId>
      </Id>
      <Description>
        [RivalAI Trigger]

        [Type:ButtonPress]

        [UseTrigger:true]

        [ButtonPanelName:{GFA_ANS_System_Transport_ButtonPanelName}]
        [ButtonPanelIndex:0]

        [MinCooldownMs:500]
        [MinCooldownMs:501]

        [Conditions:GFA_ANS_System_Transport_Condition_TargetIndex_0_Success]

        [Actions:GFA_ANS_System_Transport_Action_TargetIndex_0_Success]

        [UseElseActions:true]
        [ElseActions:GFA_ANS_System_Transport_Action_TargetIndex_0_Fail]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_Condition_TargetIndex_0_Success</SubtypeId>
      </Id>
      <Description>
        [RivalAI Condition]

        [UseConditions:true]
        [MatchAnyCondition:false]

        [CheckPlayerCondition:true]
        [PlayerConditionIds:GFA_ANS_System_Transport_PlayerCondition_TargetIndex_0_ReadyForTeleport]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_PlayerCondition_TargetIndex_0_ReadyForTeleport</SubtypeId>
      </Id>
      <Description>
        [MES Player Condition]

        [CheckPlayerReputation:true]
        [CheckReputationwithFaction:{GFA_ANS_System_Transport_Faction}]
        [MinPlayerReputation:-500]
        [MaxPlayerReputation:1501]

        [CheckPlayerCreditBalance:true]
        [MinPlayerCreditBalanceCounter:{GFA_ANS_System_Transport_TargetIndex_0_Cost}]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_Action_TargetIndex_0_Success</SubtypeId>
      </Id>
      <Description>
        [RivalAI Action]

        [//DebugMessage:System Transport TargetIndex 0 Success]

        [ChangePlayerCredits:true]
        [ChangePlayerCreditsAmountCounter:{GFA_ANS_System_Transport_TargetIndex_0_Cost_Minus}]
        [ChangePlayerCreditsIncludeSavedPlayerIdentity:true]

        [ProcessStaticEncountersAtLocation:true]
        [ProcessStaticEncountersLocationVariable:{GFA_ANS_System_Transport_TargetIndex_0_Destination}]

        [TeleportPlayers:true]
        [TeleportPlayersIncludeSavedPlayerIdentity:true]
        [TeleportPlayerCoordsVariable:{GFA_ANS_System_Transport_TargetIndex_0_Destination}]
      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GFA_ANS_System_Transport_Action_TargetIndex_0_Fail</SubtypeId>
      </Id>
      <Description>
        [RivalAI Action]

        [//DebugMessage:System Transport TargetIndex 0 Fail]
      </Description>
    </EntityComponent>

